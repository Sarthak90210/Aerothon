# Destination configuration, sensor values are unmeasured defaults.
AEROTHON_IMAGE=aerothon-runtime:20261014
AEROTHON_FCU_DEVICE=/dev/ttyAMA0
AEROTHON_FCU_BAUD=115200
AEROTHON_CAMERA_DEVICE=/dev/video0
AEROTHON_LIDAR_DEVICE=/dev/ttyUSB0
AEROTHON_LIDAR_YAW_DEG=0.0
AEROTHON_LIDAR_MIRRORED=false
AEROTHON_CAMERA_HFOV=0.851919
AEROTHON_CAMERA_EXPOSURE=100
AEROTHON_DELIVERY_CALIBRATION=
